# Copy this file to .env and fill in real values. Never commit the real .env file.

# --- API auth ---
# Shared secret clients must pass in the X-API-Key header.
API_KEY=change-me-to-a-long-random-string

# --- Database ---
# Local dev example: postgresql://postgres:postgres@localhost:5432/tickets
# Railway provides this automatically when you attach a Postgres plugin.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tickets

# --- OpenRouter (OpenAI-compatible API) ---
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Model selection (swap freely; see openrouter.ai/models for current slugs) ---
INJECTION_CHECK_MODEL=openai/gpt-4o-mini
CLASSIFICATION_MODEL=openai/gpt-4o-mini
CONFIDENCE_MODEL=anthropic/claude-sonnet-4.5
LANGUAGE_FALLBACK_MODEL=openai/gpt-4o-mini

# --- Pipeline tuning (optional — sensible defaults in app/config.py) ---
CONFIDENCE_THRESHOLD=70
MAX_LLM_RETRIES=3
FASTTEXT_CONFIDENCE_THRESHOLD=0.7
FASTTEXT_MODEL_PATH=models/lid.176.ftz

MIN_TICKET_LENGTH=3
MAX_TICKET_LENGTH=10000

RATE_LIMIT=10/minute

# --- Dashboard-only (Streamlit reads these; never exposed to end users) ---
BACKEND_API_URL=http://localhost:8000
DASHBOARD_API_KEY=change-me-to-a-long-random-string
